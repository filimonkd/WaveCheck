// WaveCheck — Event/Conference Registration System
// Phase 1: Software only. Phase 2 will add hardware check-in devices.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ATTENDEE
  ORGANIZER
  STAFF
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomFieldType {
  TEXT
  DROPDOWN
  BOOLEAN
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  OFFLINE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Display name shown at check-in; optional, so callers fall back to email.
  name         String?
  passwordHash String
  role         Role     @default(ATTENDEE)
  createdAt    DateTime @default(now())

  // Events this user organizes. Restricted rather than cascading: deleting an
  // organizer must not silently destroy published events and every attendee's
  // registration. Re-assign or archive the events first.
  organizedEvents Event[]        @relation("EventOrganizer")
  // A user's own registrations are personal data, so they follow the user.
  registrations   Registration[]
}

model Event {
  id          String      @id @default(cuid())
  organizerId String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  maxCapacity Int
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())

  organizer     User           @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  customFields  CustomField[]
  registrations Registration[]

  @@index([organizerId])
  @@index([status, startTime])
}

model CustomField {
  id         String          @id @default(cuid())
  eventId    String
  label      String
  type       CustomFieldType
  isRequired Boolean         @default(false)
  // Choices for DROPDOWN fields, as a JSON array of strings. Empty for
  // TEXT and BOOLEAN fields.
  options    Json            @default("[]")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Registration {
  id                   String             @id @default(cuid())
  eventId              String
  attendeeId           String
  // Opaque token backing the future QR code / RFID credential (Phase 2).
  credentialToken      String             @unique
  status               RegistrationStatus @default(REGISTERED)
  checkedInAt          DateTime?
  // Answers to the event's CustomFields, keyed by CustomField id.
  customFieldResponses Json               @default("{}")

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee User  @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  // One registration per attendee per event; re-registering after a
  // cancellation updates the existing row rather than inserting a duplicate.
  @@unique([eventId, attendeeId])
  @@index([eventId, status])
  @@index([attendeeId])
}

// Phase 2 hardware: physical check-in terminals (QR / RFID readers).
model Device {
  id               String       @id @default(cuid())
  deviceIdentifier String       @unique
  locationName     String
  status           DeviceStatus @default(OFFLINE)
  // scrypt hash of the device's API key, in the same format lib/password.ts
  // writes. Null for devices provisioned before key auth existed; those
  // cannot authenticate and need new credentials issuing.
  apiKeyHash       String?
  // Null until the device reports in for the first time.
  lastHeartbeatAt  DateTime?
}
