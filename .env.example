# Copy to .env and fill in before running the app.

# PostgreSQL connection string used by Prisma (CLI + runtime driver adapter).
DATABASE_URL="postgresql://postgres:password@localhost:5432/wavecheck_db?schema=public"

# Secret used to sign auth sessions. Generate one with: openssl rand -base64 32
# Auth.js reads AUTH_SECRET first and falls back to this name.
NEXTAUTH_SECRET="your-secret-key"

# Canonical origin of this deployment. Required in production: without it
# Auth.js refuses to trust the incoming Host header and every /api/auth
# request fails with UntrustedHost. Set it to your real origin when you
# deploy. (Vercel and Cloudflare Pages set this implicitly; behind a proxy
# with a dynamic host, use AUTH_TRUST_HOST=true instead.)
AUTH_URL="http://localhost:3000"
