# The WaveCheck API base URL (e.g., http://localhost:3000)
API_BASE_URL=http://localhost:3000
# The credentials generated from the WaveCheck Organizer Dashboard
DEVICE_IDENTIFIER=KIOSK-001
DEVICE_API_KEY=demo-kiosk-api-key-0001
# The serial port the RFID reader is connected to (e.g., /dev/ttyUSB0 on Linux, COM3 on Windows)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=9600
